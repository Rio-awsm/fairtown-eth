# ---------- network ----------
CHAIN_MODE=base-sepolia            # fake | anvil | base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
LOGS_RPC_URL=https://sepolia.base.org   # eth_getLogs only; Alchemy free tier caps log ranges at ~10 blocks
RPC_WS_URL=
FORK_RPC_URL=${RPC_URL}
EXPLORER_URL=https://sepolia.basescan.org
ETHERSCAN_API_KEY=

# ---------- keys (testnet only) ----------
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
AGENT_MNEMONIC=
TREASURY_ADDRESS=

# ---------- protocol params ----------
FEE_BPS=100
ADVANCE_NEW_BPS=5000
ADVANCE_PROVEN_BPS=9000
ADVANCE_TRUCK_BPS=1000
PROVEN_AFTER_CLEAN_LOTS=3
CONTEST_WINDOW_BLOCKS=600
REPORT_WINDOW_BLOCKS=3000
RULING_TIMEOUT_BLOCKS=3000           # no CRE ruling after this many blocks: anyone may expire the dispute, seller paid, no refund (D-65)
PICKUP_WINDOW_FISH=3000
PICKUP_WINDOW_FLOWERS=3000
PICKUP_WINDOW_PRODUCE=4500
PICKUP_WINDOW_TRUCK=3000
PICKUP_WINDOW_STORAGE=1500
PICKUP_WINDOW_COMPUTE=600
RELIST_STEP_BPS=1500
LAST_BLOCK_SHARE_BPS=7500
KEEPER_CHECKPOINT_BLOCKS=25        # keeper checkpoints a live auction with bids after this many quiet blocks (D-54)

# ---------- Arkiv ----------
ARKIV_MODE=live                    # live | memory
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

# ---------- AI (all pluggable) ----------
MOCK_AI=0
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
BIDDER_MODEL=
LISTING_MODEL=
VISION_BASE_URL=${LLM_BASE_URL}    # 0G: https://router-api.0g.ai/v1
VISION_API_KEY=${LLM_API_KEY}
VISION_MODEL=
VISION_EXTRA_BODY=                 # 0G: {"verify_tee":true}
STT_PROVIDER=webspeech
STT_BASE_URL=${LLM_BASE_URL}
STT_MODEL=
STT_LANGUAGE=en-US
LLM_MAX_RPM=60                     # shared request budget across AI roles (S2 5.1, D-87)
VISION_TRUST_MODE=                 # 0G: private (TeeML providers only)
VISION_FALLBACK=1                  # vision falls back to LLM_* with LISTING_MODEL if the vision provider fails (D-100)
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=

# ---------- data ----------
FX_URL=https://api.frankfurter.dev/v2/rates
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
DATA_GOV_IN_API_KEY=               # optional adapter
USDA_MARS_API_KEY=                 # optional adapter

# ---------- CRE ----------
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=local-simulation
CRE_FORWARDER_BASE_SEPOLIA=0x82300bd7c3958625581cc2f77bc6464dcecdf3e5

# ---------- add-ons, all off by default ----------
ADDON_ENS=0
ENS_SEPOLIA_RPC_URL=
ENS_PARENT_NAME=fairtown.eth
ADDON_WORLD=0
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
ADDON_HEDERA=0
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator
ENS_PRIVATE_KEY=                   # Sepolia wallet that owns ENS_PARENT_NAME (S2 8.2)
HEDERA_AGENT_ACCOUNT_ID=           # buyer agent payer account, created by pnpm -F agents hedera:setup (S2 8.4)
HEDERA_AGENT_PRIVATE_KEY=
ADDON_SWARM=0                      # lot photos also on Swarm (S2 8.5)
SWARM_BEE_URL=http://127.0.0.1:1633
SWARM_BATCH_ID=
SWARM_GATEWAY=https://bzz.limo
SWARM_BEE_PASSWORD=                # Bee keystore password (pnpm -F agents swarm:node)
SWARM_NODE_ADDRESS=
SWARM_GIFT_KEY=                    # one-time funding only (pnpm -F agents swarm:fund); never commit

# ---------- services ----------
AGENTS_PORT=8787
RELAY_PORT=8788
CRE_BRIDGE_PORT=8789
WEB_PORT=8080
ADDONS_PORT=8790
RELAY_INTERNAL_TOKEN=change-me
CRE_BRIDGE_TOKEN=change-me
CRE_BRIDGE_W1_MINUTES=30              # CRE bridge timers (0 = off): W1 FX + reference prices (S1 4.5, ICR-006)
CRE_BRIDGE_WEATHER_MINUTES=60         # W2 weather
CRE_BRIDGE_CALENDAR_MINUTES=360       # W2 calendar
CRE_BRIDGE_BROADCAST=1                # 0 = dry runs only
CRE_BRIDGE_W3=1                       # 0 = don't watch DisputeOpened
CRE_BRIDGE_TIMEOUT_MS=480000          # per run
CRE_BIN=                              # cre CLI path; default ~/.cre/bin/cre, else cre on PATH
STORAGE_DIR=./.data
PUBLIC_BASE_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:8080   # for phones: the tunnel URL, e.g. https://<name>.trycloudflare.com
VITE_API_URL=http://localhost:8787
VITE_RELAY_URL=ws://localhost:8788/ws
VITE_EXPLORER_URL=https://sepolia.basescan.org
SELLER_PIN=                        # demo PIN for seller sessions (ICR-009); unset disables POST /api/sessions/seller
TRUST_PROXY=                       # tunnel IP/CIDR, e.g. 127.0.0.1 when cloudflared runs on this machine
CORS_ORIGINS=                      # extra browser origins for agents and relay, comma separated
WALKIN_BUDGET=500
WALKIN_CAP=50
CHAIN_BACKFILL_BLOCKS=9000
